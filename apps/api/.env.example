# Server
PORT=3000
NODE_ENV=development

# Database (local docker-compose; Neon for prod)
DATABASE_URL=postgresql://bharat:bharat@localhost:5432/bharat

# Redis (Upstash for prod)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# OTP provider: dev | msg91 | twilio
OTP_PROVIDER=dev
# Msg91 (when OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
# Twilio (when OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Allowed CORS origins (comma separated)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
