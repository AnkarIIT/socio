{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@bharat/contracts$": "<rootDir>/../../../packages/contracts/src/index.ts",
    "^@bharat/shared$": "<rootDir>/../../../packages/shared/src/index.ts"
  },
  "resolver": "<rootDir>/resolver.js"
}
